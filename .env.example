WEEEK_PROJECT_ID=""

# 11. СЦЕНАРИИ И ПРАВИЛА ПИНГОВ (SLA)
MORNING_BRIEF_TIME="09:30"
REPORT_DEADLINE_MINUTES="15"
SELFIE_DEADLINE_MINUTES="15"
