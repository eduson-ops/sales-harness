# 1. МОЗГ АССИСТЕНТА (LLM)
# Бесплатный ключ Google Gemini (безлимит): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. ТЕЛЕГРАМ: ЧТЕНИЕ ЧАТОВ ОТ ТВОЕГО ЛИЦА (USERBOT)
# Позволяет ассистенту читать твои лички, группы, вылавливать блокеры и обещания
# Официальные публичные ключи Telegram API (2040):
TELEGRAM_API_ID="2040"
TELEGRAM_API_HASH="b18441a1ff607e10a989891a5462e627"
TELEGRAM_USER_PHONE=""
TELEGRAM_USER_SESSION=""

# 3. ТЕЛЕГРАМ: БОТ ДЛЯ ЛИЧНЫХ ПУШЕЙ И УТРЕННЕГО БРИФА
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# 4. AMOCRM (ВОРОНКА ПРОДАЖ)
# Твой поддомен (например, company.amocrm.ru) и долгосрочный токен:
AMOCRM_SUBDOMAIN=""
AMOCRM_ACCESS_TOKEN=""
AMOCRM_PIPELINE_ID=""

# 5. БИТРИКС24 (99 БАЛЛОВ / ОЧЕРЕДИ ЛИДОВ)
# Входящий вебхук Bitrix24 (REST API):
BITRIX24_WEBHOOK_URL=""

# 6. SLACK (КОМАНДНЫЙ ЧАТ ОП)
# Бот-токен (xoxb-...) или Webhook URL для алертов по регламентам:
SLACK_BOT_TOKEN=""
SLACK_ALERTS_CHANNEL="#оп-оперативка"

# 7. GOOGLE ТАБЛИЦЫ
# ID таблицы планов, оплат или букинга:
GOOGLE_SHEETS_SPREADSHEET_ID=""

# 8. КАЛЕНДАРИ (GOOGLE / ЯНДЕКС)
# Секретный адрес в формате iCal:
GOOGLE_CALENDAR_ICAL_URL=""
YANDEX_CALENDAR_ICAL_URL=""

# 9. NOTION (БАЗА ЗНАНИЙ И ТАСК-ТРЕКЕР)
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# 10. WEEEK (КАНБАН ЗАДАЧ)
